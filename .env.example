# Copy this file to .env and fill in the values, then restart `npm run dev`
VITE_CI_API_ENDPOINT=
VITE_CI_APP_TOKEN=
VITE_EVENTS_PATH=/events/published

# Embedding tab: URL of the CI registration form. Use {id} where the event ID goes.
# Example: https://yourportal.microsoftcrmportals.com/register/{id}
VITE_CI_EMBED_URL=
